<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);CS8632</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FortniteReplayReader" Version="3.1.0" />
  </ItemGroup>

  <!-- Le composant d'affichage de Microsoft (WebView2) que le panneau utilise pour montrer la carte dans sa fenêtre :
       il est seulement téléchargé (dans le cache NuGet), il n'est pas ajouté à cet outil. -->
  <ItemGroup>
    <PackageDownload Include="Microsoft.Web.WebView2" Version="[1.0.4314.35]" />
  </ItemGroup>

</Project>
